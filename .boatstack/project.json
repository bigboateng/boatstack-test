{
  "schema_version": 5,
  "identity": {
    "default": "developer",
    "roles": {
      "developer": {
        "kind": "command",
        "command": "gh",
        "args": ["api", "user", "--jq", ".login"]
      }
    }
  },
  "project": {
    "name": "boatstack-test",
    "default_branch": "main",
    "commands": {
      "build": "npm --prefix projects/basic-react run build",
      "test": "npm --prefix projects/basic-react run check"
    }
  },
  "policy": {
    "plan_approval": "human-or-autonomy",
    "visual_evidence": "optional",
    "external_effect_authority": "human-or-autonomy-plus-provider"
  },
  "hosts": ["cli", "cursor", "codex", "claude", "gemini", "mcp"],
  "projections": ["codex", "claude", "cursor", "gemini"]
}
