{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "owner", "objective", "dependencies", "acceptance", "verifier"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "verifier": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
