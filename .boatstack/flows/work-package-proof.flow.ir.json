              "sha256": "4811ecf2496984bc5ba77366ee27ef1f6eb4ca0fc4723913e23feb8c2561547e",
              "content": "# Journey oracles\nEmit observable end-to-end journeys with actor, setup, action sequence, boundary crossed, deterministic oracle, and evidence destination. Do not use model confidence as an oracle.\n"
            },
            "schema": {
              "path": ".boatstack/flows/assets/journey-oracles.schema.json",
              "sha256": "295701a0f3b0f9c25e8a2eb4d3a0d0fb4ba977e7a7c895cf969935cfb9baa1d8",
              "content": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"type\": \"object\",\n  \"required\": [\"journeys\"],\n  \"properties\": {\n    \"journeys\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"actor\", \"setup\", \"steps\", \"oracle\", \"evidence\"],\n        \"properties\": {\n          \"id\": { \"type\": \"string\", \"minLength\": 1 },\n          \"actor\": { \"type\": \"string\", \"minLength\": 1 },\n          \"setup\": { \"type\": \"array\", \"items\": { \"type\": \"string\", \"minLength\": 1 } },\n          \"steps\": { \"type\": \"array\", \"items\": { \"type\": \"string\", \"minLength\": 1 }, \"minItems\": 1 },\n          \"oracle\": { \"type\": \"string\", \"minLength\": 1 },\n          \"evidence\": { \"type\": \"string\", \"minLength\": 1 }\n        },\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"additionalProperties\": false\n}\n"
