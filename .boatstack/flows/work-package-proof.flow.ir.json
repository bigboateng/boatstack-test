              "content": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"type\": \"object\",\n  \"required\": [\"verifiers\"],\n  \"properties\": {\n    \"verifiers\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"kind\", \"subject\", \"oracle\", \"evidence\"],\n        \"properties\": {\n          \"id\": { \"type\": \"string\", \"minLength\": 1 },\n          \"kind\": { \"enum\": [\"repository-command\", \"inspection\", \"journey\"] },\n          \"subject\": { \"type\": \"string\", \"minLength\": 1 },\n          \"oracle\": { \"type\": \"string\", \"minLength\": 1 },\n          \"evidence\": { \"type\": \"string\", \"minLength\": 1 },\n          \"command\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": { \"type\": \"string\", \"minLength\": 1, \"pattern\": \"^[^\\\\n\\\\r]+$\" }\n          }\n        },\n        \"allOf\": [\n          {\n            \"if\": { \"properties\": { \"kind\": { \"const\": \"repository-command\" } }, \"required\": [\"kind\"] },\n            \"then\": { \"required\": [\"command\"] },\n            \"else\": { \"not\": { \"required\": [\"command\"] } }\n          }\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"additionalProperties\": false\n}\n"
