              "sha256": "ac2ca4a2e0a3d6cd3c9cec941cee9a26e49c20e0f7038256d7ba2013aa963116",
              "content": "# Tasks\nEmit deterministic task objects in dependency order. Each task must name its owner, objective, dependencies, acceptance criteria, and verifier ID and must implement an accepted specification requirement.\n"
            },
            "schema": {
              "path": ".boatstack/flows/assets/tasks.schema.json",
