    "work": [
      {
        "id": "accepted-work-package",
        "instructions": {
          "path": ".boatstack/flows/assets/accepted-work-package.md",
          "sha256": "5759a958136197e3119029e8526b082fe61050a87dbb8db1b30e1805711d1296",
          "content": "# Compile an accepted work package\n\nRead the bound repository request and inspect only the code needed to resolve its unknowns.\nAsk the user focused questions when a consequential product or implementation choice is missing.\nAfter every required answer is available, produce the exact declared artifacts.\n\nBefore the valid completion, use the same foreground-work request to prove that Boatstack rejects five malformed candidates: a task missing a required field, a verifier missing its oracle, a command represented as a shell string instead of an argv array, a journey missing its deterministic oracle, and a JSON output with an undeclared property. Preserve each exact rejection in the conversation, repair only the staged candidate, and then complete the valid package.\n\nThe final package must make scope, behavior, architecture, tasks, verification, tests, user journeys, gaps, evidence, and allowed autonomy explicit. Do not implement the feature during this work requirement.\n"
        },
        "inputs": [
          {
            "id": "plan",
            "entry_input": "plan"
          }
        ],
        "outputs": [
          {
            "id": "architecture-plan",
            "path": "architecture-plan.md",
            "media_type": "text/markdown",
            "required": true,
            "max_bytes": 262144,
            "guidance": {
              "path": ".boatstack/flows/assets/architecture-plan.md",
              "sha256": "520e26e27e103cd87462bd7bc4ac9cd9ae9f3a4e2849c84fc2ba11d816f102ff",
              "content": "# Architecture plan\n\nDescribe ownership boundaries, data flow, public interfaces, persistence, authority, failure handling, and incremental implementation seams. Keep domain policy in its owning adapter or consumer and identify the verifier for each boundary.\n"
            }
          },
          {
            "id": "autonomy",
            "path": "autonomy.md",
            "media_type": "text/markdown",
            "required": true,
            "max_bytes": 131072,
            "guidance": {
              "path": ".boatstack/flows/assets/autonomy.md",
              "sha256": "ef2aeee3d4658ceb3b1e6738f224b381d1960966812de463e37427fa736851a1",
              "content": "# Autonomy\nDescribe permitted implementation discretion and explicit exclusions. Markdown never grants authority; actual authority comes only from Boatstack delegation and transition receipts.\n"
            }
          },
          {
            "id": "evidence",
            "path": "compiled/evidence.md",
            "media_type": "text/markdown",
            "required": true,
            "max_bytes": 131072,
            "guidance": {
